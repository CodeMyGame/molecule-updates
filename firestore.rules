rules_version = '2';

// Molecule POS — cloud dashboard security rules.
//
// Deploy: Firebase Console → Firestore Database → Rules → paste → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks whether the requesting user is a Master Admin.
    // Allowed if:
    // 1. Exact match for admin@moleculepos.com
    // 2. Email ending with @moleculepos.com
    // 3. User UID exists in the /admins collection
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin@moleculepos.com' ||
        request.auth.token.email.matches('.*@moleculepos[.]com$') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Everything for a restaurant lives under restaurants/{rid}.
    // Master Admins can read ALL restaurants across the network.
    // Individual restaurant owners can ONLY read their own restaurant (rid == uid).
    // Only the owning POS account (rid == uid) can write.
    match /restaurants/{rid} {
      allow read:  if isAdmin() || (request.auth != null && request.auth.uid == rid);
      allow write: if request.auth != null && request.auth.uid == rid;

      match /{document=**} {
        allow read:  if isAdmin() || (request.auth != null && request.auth.uid == rid);
        allow write: if request.auth != null && request.auth.uid == rid;
      }
    }

    // Admins registry: readable only by admins
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Licenses collection: allows clients to check key validity and mark them as used.
    // Tiers, expiry dates, and used-status resets cannot be tampered with.
    match /licenses/{licenseKey} {
      allow read: if true;
      allow create: if request.resource.data.isUsed == true;
      allow update: if resource.data.isUsed == false
                    && request.resource.data.isUsed == true
                    && request.resource.data.tier == resource.data.tier
                    && request.resource.data.expiryDate == resource.data.expiryDate;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
