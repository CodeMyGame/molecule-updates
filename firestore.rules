rules_version = '2';

// Molecule POS — cloud dashboard security rules.
//
// Each restaurant signs in with its own email/password account. That account's
// uid IS the restaurant id, so a signed-in user can only ever touch its own
// node. This is what makes the public Firebase config (shipped in the .exe)
// harmless: the apiKey is just an identifier — these rules are the real lock.
//
// Deploy: Firebase Console → Firestore Database → Rules → paste → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // Everything for a restaurant lives under restaurants/{rid}.
    // Authenticated users (master dashboard and owner) can read restaurants data.
    // Only the owning account (the POS app matching uid) can write.
    match /restaurants/{rid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == rid;

      match /{document=**} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == rid;
      }
    }

    // Licenses collection: allows clients to check key validity and mark them as used.
    // Tiers, expiry dates, and used-status resets cannot be tampered with.
    match /licenses/{licenseKey} {
      allow read: if true;
      allow create: if request.resource.data.isUsed == true;
      allow update: if resource.data.isUsed == false
                    && request.resource.data.isUsed == true
                    && request.resource.data.tier == resource.data.tier
                    && request.resource.data.expiryDate == resource.data.expiryDate;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
